# Postgres connection string. Deployed on Vercel Postgres (Neon via the
# Vercel Marketplace), which injects DATABASE_URL into the project.
# Locally: copy the value from Vercel (Settings > Environment Variables) or run
# `vercel env pull .env`. For `prisma db push`, the unpooled URL
# (DATABASE_URL_UNPOOLED) is the safest choice.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Public Mapbox token (restrict it to your domains in the Mapbox dashboard).
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"
