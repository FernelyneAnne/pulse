# Postgres connection string (Neon, Supabase, Vercel Postgres...).
# Local: a direct or session-pooler URL (port 5432) works for `prisma db push` and dev.
# Vercel: use a pooled URL, e.g. Supabase transaction pooler (port 6543) + ?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Public Mapbox token (restrict it to your domains in the Mapbox dashboard).
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_token_here"
